@TaskManagerApi_HostAddress = http://localhost:5179

### ---------- Categories ----------

### Get all categories
GET {{TaskManagerApi_HostAddress}}/api/categories
Accept: application/json

### Get one category (with its tasks)
GET {{TaskManagerApi_HostAddress}}/api/categories/1
Accept: application/json

### Create a category
POST {{TaskManagerApi_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Work"
}

### Update a category
PUT {{TaskManagerApi_HostAddress}}/api/categories/1
Content-Type: application/json

{
  "name": "Office Work"
}

### Delete a category (its tasks are kept, CategoryId becomes null)
DELETE {{TaskManagerApi_HostAddress}}/api/categories/1

### ---------- Tasks ----------

### Get all tasks
GET {{TaskManagerApi_HostAddress}}/api/tasks
Accept: application/json

### Get one task
GET {{TaskManagerApi_HostAddress}}/api/tasks/1
Accept: application/json

### Create a task in a category
POST {{TaskManagerApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "Learn EF Core",
  "priority": "High",
  "categoryId": 1
}

### Create a task with a category that doesn't exist (400 Bad Request)
POST {{TaskManagerApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "Invalid category",
  "categoryId": 9999
}

### Update a task / mark it completed (prints an email notification in the console)
PUT {{TaskManagerApi_HostAddress}}/api/tasks/1
Content-Type: application/json

{
  "title": "Learn EF Core",
  "priority": "High",
  "isCompleted": true,
  "categoryId": 1
}

### Delete a task
DELETE {{TaskManagerApi_HostAddress}}/api/tasks/1
